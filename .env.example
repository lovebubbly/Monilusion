BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Safe defaults: paper mode and testnet unless explicitly overridden.
BINANCE_USE_TESTNET=true
DRY_RUN=true
ALLOW_LIVE_TRADING=

EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_PASSWORD=
EMAIL_RECEIVER_ADDRESS=
SMTP_SERVER=
SMTP_PORT=587

# Offline/CUDA research inputs for emacrossmart.py.
OFFLINE_OHLCV_H1=
OFFLINE_OHLCV_H4=
BT_START_DATE=2023-01-01
BT_END_DATE=2025-05-01
SEARCH_PROFILE=smoke
PARAM_START_INDEX=0
PARAM_LIMIT=1
CUDA_BATCH_SIZE=1000000
WFA_OUTPUT_DIR=wfa_optimized_params_output

# Execution-cost and promotion-gate assumptions for research runs.
COMMISSION_RATE=0.0005
SLIPPAGE_RATE=0.0002
ENTRY_DELAY_BARS=1
FUNDING_RATE_PER_8H=0.0
FUNDING_RATE_CSV=
STRICT_MIN_RETURN_PCT=30.0
STRICT_MIN_PF=1.3
STRICT_MAX_MDD_PCT=25.0
STRICT_MIN_TRADES=30
RESULTS_RANK_METRIC=return
